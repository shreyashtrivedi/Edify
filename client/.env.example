# Copy to .env.local for local development.
# Every VITE_* variable is bundled into public JavaScript: never put secrets here.

# Backend base URL (no trailing slash). In production: your Render URL.
VITE_API_URL=http://localhost:5000

# Auth0: Dashboard → Applications → Applications → Edify → Settings.
# (No client secret: single-page apps don't have one.)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
# Must match the API Identifier (Applications → APIs) and the server's AUTH0_AUDIENCE
VITE_AUTH0_AUDIENCE=https://edify-api

# Public address of the site (no trailing slash), used for link-preview images.
# In production: your Vercel URL, e.g. https://edify.vercel.app
VITE_SITE_URL=http://localhost:5173
