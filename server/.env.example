# Copy this file to .env and fill in the values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Leave empty in development to use a temporary in-memory DB.
MONGO_URI=

# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
