# Copy this file to .env and fill in the values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Leave empty in development to use a temporary in-memory DB.
MONGO_URI=

# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Development only: set to true to use sample content instead of calling Gemini
# (build/test the UI without an API key or quota). Not allowed in production.
AI_MOCK=false

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials).
# Optional: without it, lessons link to a YouTube search instead of embedding a video.
YOUTUBE_API_KEY=

# Auth0: Dashboard → Applications → APIs. Domain without https://, Audience = the API Identifier.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://edify-api
