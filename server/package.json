{
  "name": "edify-server",
  "version": "1.0.0",
  "description": "Edify (Text-to-Learn) REST API — Express + MongoDB + Gemini",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server.js",
